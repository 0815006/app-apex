FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
# 接收本地 .bat 脚本传上来的 jar 包
COPY app.jar app.jar
# 容器内使用 8093 端口启动
EXPOSE 8093
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -q --spider http://localhost:8093/api/health || exit 1
ENTRYPOINT ["java", "-Xms256m", "-Xmx512m", "-jar", "app.jar"]