<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 控制台彩色日志输出，强制 UTF-8 编码解决 Windows 中文乱码 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>%gray(%d{yyyy-MM-dd HH:mm:ss.SSS}) %highlight(%5p) %magenta(${PID:- }) %gray(---) %gray([%15.15t]) %cyan(%-40.40logger{39}) %gray(:) %m%n%xException</pattern>
        </encoder>
    </appender>

    <!-- 根日志级别 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 业务日志 -->
    <logger name="com.apex" level="DEBUG"/>

    <!-- MyBatis Plus SQL 日志 -->
    <logger name="com.apex.mapper" level="DEBUG"/>
</configuration>
